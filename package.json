{
  "name": "nightwatch",
  "version": "0.2.0",
  "private": true,
  "description": "Nightwatch (守夜人): a standalone read-only defence agent for the machine it lives on.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && node --test \"packages/*/dist/*.test.js\"",
    "web": "tsc -b && node scripts/nightwatch.mjs web",
    "tick": "tsc -b && node scripts/nightwatch.mjs tick",
    "smoke": "tsc -b && node scripts/nightwatch.mjs smoke"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@types/node": "24.19.2",
    "typescript": "5.8.3"
  }
}
