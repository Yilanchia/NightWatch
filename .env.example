# Nightwatch's own environment. Read-only collection needs none of these.
# The model key is only for talking to the agent; `nightwatch tick`-style checks must not need it.

DEEPSEEK_API_KEY=

# Paths are set by scripts/nightwatch.mjs (NIGHTWATCH_EVIDENCE_PATH and friends).
# Override only if you know why.
# NIGHTWATCH_HOME=nightwatch\.nightwatch-home
# NIGHTWATCH_PORT=3091
